---
import Base from "../layouts/Base.astro";
import { isAdmin } from "../lib/admin-env";
import { vapidPublicKey } from "../lib/push-env";

Astro.response.headers.set("Cache-Control", "no-store");
const admin = isAdmin(Astro.cookies);
---

<Base title="Settings">
	<a class="back" href="/">← Home</a>
	<h1>Settings</h1>

	<div id="settings" data-vapid={vapidPublicKey()}>
		<section class="panel">
			<h2>Who are you?</h2>
			<p class="muted">Pick your name to get reminders for your matches.</p>
			<p id="chosen" class="chosen" hidden>
				<span id="chosen-name"></span>
				<button id="clear" class="link" type="button">Clear</button>
			</p>
			<input id="search" type="search" placeholder="Search your name" autocomplete="off" />
			<div id="players" class="players" role="listbox" aria-label="Players"></div>
		</section>

		<section id="install" class="panel" hidden>
			<h2>Install the app</h2>
			<p class="muted">
				Add La Puntilla to your home screen to open it like an app: in Chrome tap <strong>⋮</strong> (top right), then{" "}
				<strong>Install app</strong> or <strong>Add to Home screen</strong>.
			</p>
			<button id="install-button" class="toggle" type="button" hidden>Install</button>
		</section>

		<section class="panel">
			<h2>Notifications</h2>
			<p id="push-note" class="muted">Choose your name first.</p>
			<div id="push-controls" hidden>
				<button id="toggle" class="toggle" type="button" aria-pressed="false">Notifications off</button>
				<p id="push-status" class="muted" aria-live="polite"></p>
			</div>
		</section>

		<section class="panel">
			<h2>Your matches</h2>
			<ul id="matches" class="matches"><li class="muted">Choose your name to see your matches.</li></ul>
		</section>

		<section class="panel">
			<h2>Admin</h2>
			{
				admin ? (
					<>
						<p class="muted">You're an admin: you can referee matches and change scores.</p>
						<button id="admin-logout" class="link" type="button">Sign out</button>
					</>
				) : (
					<>
						<button id="admin-open" class="toggle" type="button">Become admin</button>
						<form id="admin-form" class="admin-form" hidden>
							<input id="admin-password" type="password" placeholder="Password" autocomplete="current-password" />
							<button class="toggle" type="submit">Sign in</button>
							<p id="admin-error" class="error" aria-live="polite" />
						</form>
					</>
				)
			}
		</section>
	</div>
</Base>

<script>
	import "../scripts/settings";
	import "../scripts/admin-settings";
</script>

<style>
	.back {
		font-weight: 600;
		text-decoration: none;
	}
	h1 {
		margin: 8px 0 12px;
	}
	.panel {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 14px;
		margin-bottom: 12px;
	}
	h2 {
		margin: 0 0 4px;
		font-size: 17px;
	}
	.panel p {
		margin: 4px 0 10px;
	}
	.chosen[hidden] {
		display: none;
	}
	.chosen {
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-weight: 700;
	}
	input {
		width: 100%;
		font: inherit;
		padding: 10px 12px;
		border: 1px solid var(--line);
		border-radius: 10px;
		background: var(--bg);
		color: var(--text);
	}
	.players {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
		gap: 6px;
		margin-top: 10px;
		max-height: 260px;
		overflow-y: auto;
	}
	.players :global(button) {
		font: inherit;
		text-align: left;
		padding: 8px 10px;
		border-radius: 10px;
		border: 1px solid var(--line);
		background: var(--bg);
		color: var(--text);
		cursor: pointer;
	}
	.players :global(button[aria-selected="true"]) {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--accent-text);
		font-weight: 700;
	}
	.toggle {
		font: inherit;
		font-weight: 700;
		width: 100%;
		padding: 12px;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--bg);
		color: var(--text);
		cursor: pointer;
	}
	.toggle[aria-pressed="true"] {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-text);
	}
	.link {
		font: inherit;
		background: none;
		border: 0;
		padding: 8px 0;
		color: var(--accent);
		font-weight: 600;
		cursor: pointer;
	}
	.admin-form {
		display: grid;
		gap: 8px;
	}
	.error {
		color: #c0392b;
		font-weight: 600;
		margin: 0;
	}
	.matches {
		list-style: none;
		margin: 6px 0 0;
		padding: 0;
		display: grid;
		gap: 8px;
	}
	.matches :global(li) {
		font-size: 15px;
	}
	.matches :global(li.past) {
		opacity: 0.45;
		filter: grayscale(1);
	}
	.matches :global(li.divider) {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 4px 0;
		font-size: 12px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.matches :global(li.divider)::before,
	.matches :global(li.divider)::after {
		content: "";
		flex: 1;
		border-top: 1px solid var(--line);
	}
	.matches :global(.role) {
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--accent);
	}
</style>
