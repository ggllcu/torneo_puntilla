---
import Base from "../../layouts/Base.astro";
import { isAdmin } from "../../lib/admin-env";
import { loadMatch, loadSession } from "../../lib/data";
import { formatScore, roundLabel } from "../../lib/display";
import { calendarPath } from "../../lib/routes";
import { formatTime, matchTime } from "../../lib/schedule";

Astro.response.headers.set("Cache-Control", "no-store");

const match = await loadMatch(Astro.params.id ?? "");
if (!match) return Astro.rewrite("/404");

const session = await loadSession(match.category, match.day);
const time = formatTime(matchTime(session, match.slot, match.timeOverride));
const backUrl = `${calendarPath(match.category, match.day)}#match-${match.id}`;
// Finished matches can be re-refereed to change their score ("Change score" on the calendar).
// Everyone can keep score; only admins can send it (and change a finished match's score).
const admin = isAdmin(Astro.cookies);
const teamsSet = match.team1 !== null && match.team2 !== null;
const ready = teamsSet && (match.state !== "finished" || admin);
const changing = match.state === "finished";
const escape = (text: string) =>
	text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
const info = `${match.day === "saturday" ? "Sat" : "Sun"} ${time} · Court ${match.court} · ${roundLabel(match)}`;
---

<Base title={`Referee · ${roundLabel(match)}`} category={match.category} fullHeight={ready}>
	<div class="referee-page">
	<header class="toolbar">
		<a class="back" href={backUrl}>← Calendar</a>
		<p class="info">{info}</p>
		{ready && <button id="scoring-display" type="button" class="display-toggle" hidden>Fullscreen</button>}
	</header>

	{
		ready ? (
			<div
				id="referee"
				data-id={match.id}
				data-format={match.format}
				data-team1={match.team1!.name}
				data-team2={match.team2!.name}
				data-back={backUrl}
				data-admin={admin ? "true" : undefined}
				data-saved-sets={changing ? JSON.stringify(match.sets) : undefined}
			>
				<p id="rotate-hint" class="rotate-hint" role="status" hidden>Rotate your phone for landscape scoring.</p>
				{changing && (
					<p class="changing">
						Changing the submitted score{match.sets.length ? `: ${formatScore(match.sets)}` : ""}. Adjust it and
						send it again.
					</p>
				)}
				<p id="set-info" class="set-info" hidden />
				<div class="names">
					{[match.team1!, match.team2!].map((t) => (
						<p class="team">
							<span class="seed">{t.seed}</span>
							<span set:html={t.name.split("/").map(escape).join("/<wbr>")} />
						</p>
					))}
				</div>
				<div class="board">
					<button class="plus" data-team="1" aria-label={`Point to ${match.team1!.name}`}>
						+
					</button>
					<p class="score" aria-live="polite">
						<span id="score1">0</span>
						<span class="dash">-</span>
						<span id="score2">0</span>
					</p>
					<button class="plus" data-team="2" aria-label={`Point to ${match.team2!.name}`}>
						+
					</button>
					<button class="minus" data-team="1" aria-label={`Remove a point from ${match.team1!.name}`}>
						−
					</button>
					<span />
					<button class="minus" data-team="2" aria-label={`Remove a point from ${match.team2!.name}`}>
						−
					</button>
					<p id="serve1" class="serve" aria-live="polite" hidden />
					<p id="serve2" class="serve" aria-live="polite" hidden />
				</div>

				<dialog id="serving-setup" class="modal serving-setup" aria-labelledby="serving-title">
					<form id="serving-form">
						<h2 id="serving-title">Serving setup</h2>
						<p id="serving-resume" class="resume" hidden>Your score is saved. Choose the team serving now and each team's next server.</p>
						<label for="starting-team">Which team starts?</label>
						<select id="starting-team" name="starting-team" required autofocus>
							<option value="" disabled selected>Choose a team</option>
							<option value="1">{match.team1!.name}</option>
							<option value="2">{match.team2!.name}</option>
						</select>
						<fieldset>
							<legend>Who serves first?</legend>
							{[match.team1!, match.team2!].map((team, index) => (
								<div class="server-choice">
									<label for={`first-server${index + 1}`}>{team.name}</label>
									<select id={`first-server${index + 1}`} name={`first-server${index + 1}`} required>
										<option value="" disabled selected>Choose a player</option>
										{team.name.split("/").map((player, playerIndex) => (
											<option value={playerIndex}>{player.trim()}</option>
										))}
									</select>
								</div>
							))}
						</fieldset>
						<div class="actions single">
							<button class="primary" type="submit">Start scoring</button>
						</div>
					</form>
				</dialog>

				{
					admin && (
						<button id="send" class="send" type="button" disabled>
							Send score
						</button>
					)
				}

				<div id="modal" class="overlay" hidden>
					<div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
						<h2 id="modal-title">{admin ? "Submit Score" : "The game is finished"}</h2>
						<p id="modal-winner" class="winner" />
						<p id="modal-score" class="final" />
						<p id="modal-error" class="error" hidden />
						{admin ? (
							<div class="actions">
								<button id="cancel" class="secondary">Cancel</button>
								<button id="submit" class="primary">Submit</button>
							</div>
						) : (
							<div class="actions single">
								<button id="cancel" class="primary">OK</button>
							</div>
						)}
					</div>
				</div>
			</div>
		) : (
			<div class="closed">
				<p>{teamsSet ? "This match is already finished." : "The teams for this match are not decided yet."}</p>
				<a href={backUrl}>Back to the calendar</a>
			</div>
		)
	}
	</div>
</Base>

<script>
	import "../../scripts/referee";
</script>

<style>
	.referee-page {
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: 8px;
	}
	.toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 36px;
	}
	#referee {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		gap: 8px;
	}
	.back {
		flex-shrink: 0;
		font-weight: 600;
		text-decoration: none;
	}
	.info {
		margin: 0;
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.display-toggle {
		flex-shrink: 0;
		min-height: 36px;
		padding: 6px 10px;
		background: var(--surface);
		color: var(--text);
		border: 1px solid var(--line);
		font-size: 13px;
		font-weight: 600;
	}
	.rotate-hint {
		margin: 0;
		text-align: center;
		font-size: 13px;
	}
	.set-info {
		text-align: center;
		font-weight: 700;
		margin: 0;
	}
	.names {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 10px;
		align-items: end;
	}
	.team {
		margin: 0;
		text-align: center;
		font-weight: 700;
		font-size: 18px;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}
	.seed {
		display: block;
		color: var(--cat);
		font-size: 13px;
	}
	.board {
		display: grid;
		flex: 1;
		min-height: 128px;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		grid-template-rows: minmax(44px, 1fr) 44px minmax(24px, auto);
		align-items: stretch;
		gap: 8px;
	}
	button {
		font: inherit;
		border: 0;
		border-radius: var(--radius);
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
	}
	.plus {
		min-height: 0;
		background: var(--cat);
		color: #fff;
		font-size: 64px;
		font-weight: 300;
	}
	.plus:active,
	.minus:active {
		transform: scale(0.97);
	}
	.minus {
		min-height: 44px;
		background: var(--surface);
		color: var(--text);
		border: 1px solid var(--line);
		font-size: 28px;
	}
	.score {
		margin: 0;
		display: flex;
		align-items: baseline;
		align-self: center;
		gap: 4px;
		font-size: clamp(34px, 11vw, 64px);
		font-weight: 800;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		white-space: nowrap;
	}
	.serve {
		grid-row: 3;
		margin: 2px 0 0;
		text-align: center;
		font-weight: 700;
		overflow-wrap: anywhere;
	}
	#serve1 {
		grid-column: 1;
	}
	#serve2 {
		grid-column: 3;
	}
	.serving-setup {
		border: 0;
		color: var(--text);
		max-height: calc(100dvh - 32px);
		overflow-y: auto;
		text-align: left;
	}
	.serving-setup::backdrop {
		background: rgb(0 0 0 / 0.5);
	}
	.serving-setup label,
	.serving-setup legend {
		display: block;
		font-weight: 700;
	}
	.serving-setup select {
		display: block;
		width: 100%;
		min-width: 0;
		min-height: 48px;
		margin-top: 6px;
		padding: 10px;
		font: inherit;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.serving-setup fieldset {
		min-width: 0;
		margin: 20px 0;
		padding: 0;
		border: 0;
	}
	.server-choice {
		margin-top: 12px;
	}
	.server-choice label,
	.resume {
		font-size: 14px;
	}
	.serving-setup :focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.dash {
		color: var(--muted);
	}
	.changing {
		margin: 0;
		padding: 6px 10px;
		border-radius: 10px;
		background: var(--surface);
		border: 1px solid var(--line);
		font-size: 12px;
	}
	.send {
		display: block;
		width: 100%;
		flex-shrink: 0;
		min-height: 44px;
		padding: 10px;
		font-weight: 800;
		font-size: 18px;
		background: var(--accent);
		color: var(--accent-text);
	}
	.send:disabled {
		background: var(--line);
		color: var(--muted);
		cursor: not-allowed;
	}
	.overlay {
		position: fixed;
		inset: 0;
		z-index: 20;
		display: grid;
		place-items: center;
		padding: 16px;
		background: rgb(0 0 0 / 0.5);
	}
	.overlay[hidden] {
		display: none;
	}
	.modal {
		width: 100%;
		max-width: 360px;
		background: var(--surface);
		border-radius: var(--radius);
		padding: 20px;
		text-align: center;
		max-height: calc(100dvh - 24px);
		overflow-y: auto;
	}
	.modal h2 {
		margin: 0 0 12px;
	}
	.winner {
		margin: 0;
		color: var(--muted);
	}
	.final {
		margin: 6px 0 16px;
		font-size: 32px;
		font-weight: 800;
	}
	.error {
		color: #c0392b;
		font-weight: 600;
	}
	.actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}
	.actions button {
		padding: 14px;
		font-weight: 700;
	}
	.actions.single {
		grid-template-columns: 1fr;
	}
	.primary {
		background: var(--accent);
		color: var(--accent-text);
	}
	.secondary {
		background: var(--bg);
		color: var(--text);
		border: 1px solid var(--line);
	}
	.closed {
		margin-top: 24px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 20px;
	}
	button:focus-visible,
	.back:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	@media (max-width: 480px) and (orientation: portrait) {
		.toolbar {
			flex-wrap: wrap;
			gap: 4px 12px;
		}
		.info {
			order: 1;
			width: 100%;
		}
	}
</style>
