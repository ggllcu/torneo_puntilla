---
// Gear icon linking to /settings, with a "You: Dani" hint once a player is chosen on this device.
---

<a class="settings-link" href="/settings" aria-label="Settings">
	<span class="you" data-you hidden></span>
	<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="3"></circle>
		<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.08a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.08a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
	</svg>
</a>

<script is:inline>
	try {
		const player = JSON.parse(localStorage.getItem("puntilla:player") || "null");
		if (player && player.name)
			for (const el of document.querySelectorAll("[data-you]")) {
				el.textContent = "You: " + player.name;
				el.hidden = false;
			}
	} catch {}
</script>

<style>
	.settings-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--muted);
		text-decoration: none;
		padding: 6px;
		border-radius: 999px;
	}
	.settings-link:hover {
		color: var(--text);
	}
	.you {
		font-size: 13px;
		font-weight: 600;
		white-space: nowrap;
		max-width: 9em;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
