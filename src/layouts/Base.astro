---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/global.css";

interface Props {
	title: string;
	category?: string;
}

const SITE_TITLE = "La Puntilla Beach Volley";
const { title, category } = Astro.props;
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title,
	siteName: SITE_TITLE,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#082858" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="icon" href="/icons/favicon-32.png" type="image/png" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="La Puntilla" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<script is:inline>
			if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js");
		</script>
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body data-category={category}>
		<EmDashBodyStart page={pageCtx} />
		<slot name="header" />
		<main id="live">
			<slot />
		</main>
		<EmDashBodyEnd page={pageCtx} />
		<script>
			import "../scripts/push-sync";
		</script>
	</body>
</html>
